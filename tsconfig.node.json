{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "skipLibCheck": true,

    "moduleResolution": "node",
    "strict": false,
    "noEmit": true,

    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },

  "include": ["vite.config.ts"],
  "exclude": [
    "src",
    "**/*.ts",
    "**/*.tsx",
    "node_modules"
  ]
}
